# Same-origin path. In dev it is served by the Vite proxy, in production by the
# /api rewrite in vercel.json. Only override with an absolute URL if you drop
# the rewrite (the API sends Access-Control-Allow-Origin: *, so that works too).
VITE_API_BASE_URL=/api

# Backend origin the dev proxy and the Vercel rewrite forward to.
VITE_API_PROXY_TARGET=https://woodencorner-001-site2.gtempurl.com

# Host serving product/category images. Empty means the paths stored in the API
# resolve against this app's own public/ folder.
VITE_ASSET_BASE_URL=

# Customer account features (wired to the API).
VITE_ENABLE_REVIEWS=true
VITE_ENABLE_REFUNDS=true
VITE_ENABLE_SAVED_ADDRESSES=true
VITE_ENABLE_PROFILE_EDIT=true
